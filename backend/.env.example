# 資料庫設定
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=wellmade_user
DB_PASSWORD=postgres
DB_NAME=wellmade

# JWT 設定
JWT_SECRET=super_secret_jwt_key_for_development_only  # 生產環境必須使用強密碼
JWT_EXPIRATION_TIME=1d  # Token 有效期 (例如: 3600s = 1小時, 1d = 1天)
JWT_EXPIRES_IN=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google  # 生產環境：https://wellmade.select/api/auth/callback/google

# 環境設定 (生產環境必需)
BASE_URL=http://localhost:3003  # 生產環境：https://api.wellmade.select
FRONTEND_URL=http://localhost:3000  # 生產環境：https://wellmade.select

# 檔案上傳設定 (可選)
UPLOAD_PATH=  # 預設使用 ./uploads，可設定為絕對路徑

# Newebpay 金流設定 (開發環境測試用)
NEWEBPAY_MERCHANT_ID=MS350175746
NEWEBPAY_HASH_KEY=development_hash_key_replace_with_real_key
NEWEBPAY_HASH_IV=development_hash_iv_replace_with_real_iv
NEWEBPAY_API_URL=https://ccore.newebpay.com/MPG/mpg_gateway
NEWEBPAY_RETURN_URL=http://localhost:3003/payment/return  # 生產環境：https://api.wellmade.select/payment/return
NEWEBPAY_NOTIFY_URL=http://localhost:3003/payment/notify  # 生產環境：https://api.wellmade.select/payment/notify
NEWEBPAY_CLIENT_BACK_URL=http://localhost:3000/checkout/success  # 生產環境：https://wellmade.select/checkout/success

# 注意：
# - 生產環境必須設定 BASE_URL 和 FRONTEND_URL，否則功能會異常
# - 所有包含 localhost 的 URL 在生產環境都必須更換
# - JWT_SECRET 在生產環境必須使用至少 32 字元的強密碼