# 資料庫設定 (Zeabur 會自動提供 PostgreSQL 連線資訊)
DB_HOST=localhost  # 生產環境由 Zeabur 提供
DB_PORT=5432
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=wellmade

# JWT 設定
JWT_SECRET=super_secret_jwt_key_for_development_only  # 生產環境請使用強密碼
JWT_EXPIRES_IN=1d

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/callback/google  # 生產環境改為 https://wellmade.select/api/auth/callback/google

# 前端 URL (用於 CORS)
FRONTEND_URL=https://wellmade.select  # 你的前端域名

# Session Secret
SESSION_SECRET=your-session-secret-here  # 使用 openssl rand -base64 32 生成

# 環境設定
NODE_ENV=development  # 生產環境設為 production
PORT=3003  # Zeabur 會自動提供

# 藍新金流設定
NEWEBPAY_MERCHANT_ID=your_merchant_id
NEWEBPAY_HASH_KEY=your_hash_key
NEWEBPAY_HASH_IV=your_hash_iv
NEWEBPAY_API_URL=https://ccore.newebpay.com/MPG/mpg_gateway
NEWEBPAY_RETURN_URL=http://localhost:3003/payment/return  # 生產環境改為 https://api.wellmade.select/payment/return
NEWEBPAY_NOTIFY_URL=http://localhost:3003/payment/notify  # 生產環境改為 https://api.wellmade.select/payment/notify
NEWEBPAY_CLIENT_BACK_URL=http://localhost:3000/checkout/success  # 生產環境改為 https://wellmade.select/checkout/success
