# NextAuth 設定
NEXTAUTH_URL=http://localhost:3000  # 生產環境：https://wellmade.select
NEXTAUTH_SECRET=your-nextauth-secret-here  # 使用 openssl rand -base64 32 生成

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API 設定
NEXT_PUBLIC_API_URL=http://localhost:3003  # 生產環境：https://api.wellmade.select

# 後端服務 URL (用於 next.config.js 和 NextAuth)
BACKEND_URL=http://localhost:3003  # 生產環境：https://api.wellmade.select

# 注意：
# - 所有 localhost URL 在生產環境都必須更換為正確的域名
# - BACKEND_URL 是必需的，不能為空，否則認證功能會失敗
# - 確保環境變數在部署平台正確設定