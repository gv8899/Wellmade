# NextAuth 設定
NEXTAUTH_URL=http://localhost:3000  # 生產環境改為 https://wellmade.select
NEXTAUTH_SECRET=your-nextauth-secret-here  # 使用 openssl rand -base64 32 生成

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# API 設定
API_URL=http://localhost:3003/api  # 生產環境改為後端的 URL
NEXT_PUBLIC_API_URL=http://localhost:3003  # 生產環境改為後端的 URL

# 後端服務 URL (用於 next.config.js)
BACKEND_URL=http://localhost:3003  # 生產環境改為後端的 URL